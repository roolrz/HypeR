  "format": "hyper.board.v1",
  "board": "rpi5-native",
  "architecture": "aarch64",
  "boot": "rpi5-firmware",
  "disk": {
    "uuid": "90bbd4bb-efff-4640-89dc-f0d58a6d3467",
    "config-mib": 64
  },
  "files": {
    "hyper.img": "hyper",
    "bootstrap.cpio": "bootstrap",
    "bcm2712-rpi-5-b.dtb": "host-dtb",
    "bcm2712d0-rpi-5-b.dtb": "host-dtb-d0",
    "overlays/bcm2712d0.dtbo": "host-overlay-d0",
    "overlays/overlay_map.dtb": "host-overlay-map",
    "boot-notices.txt": "boot-notices"
  },
  "virtual-machines": [],
  "io-vm": {
    "runtime": "io-runtime",
    "name": "io",
    "image": "/vm/io.itb",
    "configuration": {
      "memory-bytes": 134217728,
      "vcpus": 1,
      "bootargs": "console=ttyAMA0 earlycon=pl011,mmio32,0x09000000 rdinit=/init loglevel=4 hyper.role=io hyper.mode=standby hyper.volumes=required"
    },
    "io-device": {
      "profile": "bcm2712-sdhci",
      "path": "/soc@107c000000/mmc@fff000"
    }
  }
}
