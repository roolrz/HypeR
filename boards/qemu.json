  "format": "hyper.board.v1",
  "board": "qemu",
  "architecture": "aarch64",
  "boot": "qemu-direct",
  "disk": {
    "uuid": "09f8feba-c8e5-46df-bb97-ceba1c4f334b",
    "config-mib": 1024
  },
  "files": {
    "vm/alpine.itb": "alpine"
  },
  "virtual-machines": [
    {
      "name": "alpine",
      "image": "vm/alpine.itb",
      "autostart": false,
      "disk-mib": 2048,
      "disk-image": "alpine-rootfs",
      "configuration": {
        "memory-bytes": 268435456,
        "vcpus": 2,
        "bootargs": "console=ttyAMA0 earlycon=pl011,mmio32,0x09000000 rdinit=/init loglevel=7 hyper.root=/dev/sda"
      }
    }
  ],
  "io-vm": {
    "runtime": "io-runtime",
    "name": "io",
    "image": "/vm/io.itb",
    "configuration": {
      "memory-bytes": 134217728,
      "vcpus": 1,
      "bootargs": "console=ttyAMA0 earlycon=pl011,mmio32,0x09000000 rdinit=/init loglevel=4 hyper.role=io hyper.mode=standby hyper.volumes=required"
    },
    "io-device": {
      "profile": "virtio-mmio-scsi",
      "compatible": "virtio,mmio"
    }
  }
}
