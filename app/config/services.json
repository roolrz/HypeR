{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "format": "hyper.service-manifest",
  "services": [
    {
      "name": "console-input",
      "image": "/svc/console-input",
      "critical": false,
      "restart": "never",
      "after": [],
      "capabilities": [
        {
          "source": "bootstrap.console",
          "purpose": "console.system",
          "operation": "duplicate",
          "rights": ["wait", "read"]
        },
        {
          "source": "bootstrap.console-input-channel",
          "purpose": "console.data",
          "operation": "move",
          "rights": ["wait", "write"]
        }
      ]
    },
    {
      "name": "console-output",
      "image": "/svc/console-output",
      "critical": false,
      "restart": "never",
      "after": [],
      "capabilities": [
        {
          "source": "bootstrap.console",
          "purpose": "console.system",
          "operation": "duplicate",
          "rights": ["wait", "write"]
        },
        {
          "source": "bootstrap.console-output-channel",
          "purpose": "console.data",
          "operation": "move",
          "rights": ["wait", "read"]
        }
      ]
    },
    {
      "name": "session",
      "image": "/svc/session",
      "critical": true,
      "restart": "never",
      "after": ["console-input", "console-output"],
      "capabilities": [
        {
          "source": "bootstrap.session-input-channel",
          "purpose": "session.console-input",
          "operation": "move",
          "rights": ["wait", "read"]
        },
        {
          "source": "bootstrap.session-output-channel",
          "purpose": "session.console-output",
          "operation": "move",
          "rights": ["wait", "write"]
        },
        {
          "source": "bootstrap.session-client-input-channel",
          "purpose": "session.client-input",
          "operation": "move",
          "rights": ["wait", "write"]
        },
        {
          "source": "bootstrap.session-client-output-channel",
          "purpose": "session.client-output",
          "operation": "move",
          "rights": ["wait", "read"]
        },
        {
          "source": "bootstrap.session-client-error-channel",
          "purpose": "session.client-error",
          "operation": "move",
          "rights": ["wait", "read"]
        }
      ]
    },
    {
      "name": "shell",
      "image": "/bin/sh",
      "critical": false,
      "restart": "never",
      "after": ["session"],
      "capabilities": [
        {
          "source": "bootstrap.shell-input-channel",
          "purpose": "stdio.input",
          "operation": "move",
          "rights": ["wait", "read"]
        },
        {
          "source": "bootstrap.shell-output-channel",
          "purpose": "stdio.output",
          "operation": "move",
          "rights": ["wait", "write"]
        },
        {
          "source": "bootstrap.shell-error-channel",
          "purpose": "stdio.error",
          "operation": "move",
          "rights": ["wait", "write"]
        },
        {
          "source": "bootstrap.root-directory",
          "purpose": "process.root-directory",
          "operation": "duplicate",
          "rights": ["read", "duplicate", "transfer", "execute"]
        },
        {
          "source": "bootstrap.task-factory",
          "purpose": "process.task-factory",
          "operation": "duplicate",
          "rights": ["create-process"]
        },
        {
          "source": "bootstrap.task-group",
          "purpose": "process.task-group",
          "operation": "duplicate",
          "rights": ["attach-process"]
        },
        {
          "source": "bootstrap.resource-domain",
          "purpose": "process.resource-domain",
          "operation": "duplicate",
          "rights": ["sponsor"]
        },
        {
          "source": "bootstrap.task-inspector",
          "purpose": "process.task-inspector",
          "operation": "duplicate",
          "rights": ["duplicate", "transfer", "inspect"]
        },
        {
          "source": "bootstrap.object-inspector",
          "purpose": "process.object-inspector",
          "operation": "duplicate",
          "rights": ["duplicate", "transfer", "inspect"]
        }
      ]
    }
  ]
}
